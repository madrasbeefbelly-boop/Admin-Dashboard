{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/dashboard.js": {
      "includeFiles": "certificates/supabase-root-2021.crt"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/dashboard?__dashboard_path=:path*"
    },
    {
      "source": "/:page(login|signup|menu|inventory|purchases|orders|profit|settings)",
      "destination": "/index.html"
    },
    {
      "source": "/auth/callback",
      "destination": "/index.html"
    }
  ]
}
